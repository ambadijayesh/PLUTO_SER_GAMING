@app.route("/upload", methods=["POST"])
@admin_required
def upload():
    f = request.files.get("file")
    category = request.form.get("category")

    if not f or not f.filename:
        return "No file selected", 400

    if category not in CATEGORIES:
        return "Invalid folder", 400

    original = secure_filename(f.filename)

    if "." not in original:
        return "Invalid file", 400

    ext = original.rsplit(".", 1)[1].lower()

    if ext in IMAGES:
        kind = "image"
    elif ext in VIDEOS:
        kind = "video"
    else:
        return "Only images and videos allowed", 400

    name = uuid.uuid4().hex + "." + ext

    folder_path = os.path.join(UPLOAD_FOLDER, category)
    os.makedirs(folder_path, exist_ok=True)

    f.save(os.path.join(folder_path, name))

    files.append({
        "name": name,
        "category": category,
        "kind": kind
    })

    save_files()

    return redirect("/folder/" + category)


@app.route("/delete", methods=["POST"])
@admin_required
def delete():
    name = request.form.get("filename", "")
    category = request.form.get("category", "")

    if category not in CATEGORIES:
        abort(400)

    item = next(
        (
            x for x in files
            if x.get("name") == name
            and x.get("category") == category
        ),
        None
    )

    if not item:
        return "File not found", 404

    path = os.path.join(UPLOAD_FOLDER, category, name)

    if os.path.isfile(path):
        os.remove(path)

    files.remove(item)
    save_files()

    return redirect("/folder/" + category)


